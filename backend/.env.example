# MongoDB Atlas or a replica set (transactions and change streams are required)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/lovelle?retryWrites=true&w=majority
# Generate a NEW secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=4000
NODE_ENV=development
# Exact comma-separated frontend origins; HTTPS required in production
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
# Vercel enables distributed Socket.IO automatically; enable this for multiple local servers
SOCKET_DISTRIBUTED=false
# Leave unset on Vercel (defaults to 1); use 0 for a direct local connection
# TRUST_PROXY=0
